    "initial": {
      "answerability": "answerable",
      "summary": "截至2025-06-01可知资料，美联储2025-05-07报告基于2025-04-11前数据，指出对冲基金杠杆接近十年高位且集中于大基金（F03），但不可直接解读为银行系统失稳。报告明确银行资本普遍远高于监管要求、韧性良好（F04），家庭与企业债务脆弱性温和且占GDP比下降（F05），融资风险降至温和（F06）。同时市场存在估值高、流动性恶化但有序（F02），及信用卡与车贷拖欠超疫情前（F07）等局部隐患。整体属结构性分化而非系统失稳。",
      "claims": [
        {
          "id": "C1",
          "text": "美联储报告数据截止2025-04-11、披露于2025-05-07，评估美国金融体系状况",
          "kind": "fact",
          "role": "context",
          "evidence_ids": [
            "F01"
          ],
          "numbers": []
        },
        {
          "id": "C2",
          "text": "对冲基金杠杆指标接近十年高位且集中于较大基金",
          "kind": "fact",
          "role": "risk",
          "evidence_ids": [
            "F03"
          ],
          "numbers": []
        },
        {
          "id": "C3",
          "text": "银行体系保持广泛韧性，多数机构资本远高于监管要求",
          "kind": "fact",
          "role": "driver",
          "evidence_ids": [
            "F04"
          ],
          "numbers": []
        },
        {
          "id": "C4",
          "text": "家庭与企业债务脆弱性温和，债务相对GDP比重下降",
          "kind": "fact",
          "role": "driver",
          "evidence_ids": [
            "F05"
          ],
          "numbers": []
        },
        {
          "id": "C5",
          "text": "融资脆弱性降至温和水平，但可挤兑负债仍是持续风险",
          "kind": "fact",
          "role": "risk",
          "evidence_ids": [
            "F06"
          ],
