    "extraction_raw": {
      "facts": [
        {
          "chunk_id": "P7AD084B61B1",
          "quote": "期内本公司权益持有人归属盈利为人民币631 亿元，同比增长10%。",
          "text": "2Q2025非国际财务报告准则本公司权益持有人归属盈利（即非IFRS归母盈利）为631亿元，同比增10%",
          "value": 631,
          "raw_number": "631",
          "unit": "人民币亿元",
          "role": "support",
          "status": "observed"
        },
        {
          "chunk_id": "P7AD084B61B1",
          "quote": "剔除本季及去年同期非国际财务报告准则分占联营公司及合营公司盈利后，2Q2025 的非国际财务报告准则本公司权益持有人归属盈利为人民币568 亿元，同比增长20%。",
          "text": "剔除本季及去年同期非IFRS分占联营合营盈利后，2Q2025非IFRS归母盈利为568亿元，同比增20%",
          "value": 568,
          "raw_number": "568",
          "unit": "人民币亿元",
          "role": "support",
          "status": "observed"
        },
        {
          "chunk_id": "P7AD084B61B1",
          "quote": "按非国际财务报告准则，撇除若干一次性及/或非现金项目的影响，以体现核心业务的业绩：",
          "text": "非IFRS口径为撇除若干一次性及/或非现金项目以体现核心业务业绩",
          "value": null,
          "raw_number": "",
          "unit": "",
          "role": "definition",
          "status": "definition"
        },
        {
          "chunk_id": "P7AD084B61B1",
          "quote": "非国际财务报告准则撇除股份酬金、并购带来的效应，如来自投资公司的（收益）/ 亏损净额、无形资产摊销及减值拨备/（拨回）、集团可持续社会价值及共同富裕计划项目所产生的捐款及开支、所得税影响及其他",
          "text": "非IFRS具体撇除项目含股份酬金、投资公司损益、无形资产摊销等",
          "value": null,
          "raw_number": "",
          "unit": "",
          "role": "definition",
          "status": "definition"
        },
        {
          "chunk_id": "P7AD084B61B1",
          "quote": "期内盈利为人民币648 亿元，同比增长11%。",
          "text": "2Q2025非IFRS期内盈利648亿元，同比增11%（非归母口径）",
          "value": 648,
          "raw_number": "648",
          "unit": "人民币亿元",
          "role": "support",
          "status": "observed"
        },
        {
          "chunk_id": "P7AD084B61B1",
          "quote": "经营盈利为人民币692 亿元，同比增长18%；经营利润率由去年的36%上升至38%。",
          "text": "2Q2025非IFRS经营盈利692亿元，同比增18%",
          "value": 692,
          "raw_number": "692",
          "unit": "人民币亿元",
          "role": "support",
          "status": "observed"
        },
        {
          "chunk_id": "P7AD084B61B1",
          "quote": "分占联营公司及合营公司盈利/（亏损）净额 4,473",
          "text": "根据p5表，2Q2025分占联营公司及合营公司盈利净额为4473百万元（IFRS口径），为非IFRS调整前数据",
          "value": 4473,
          "raw_number": "4,473",
          "unit": "人民币百万元",
          "role": "support",
          "status": "observed"
        },
        {
          "chunk_id": "P7AD084B69B1",
          "quote": "分占联营公司及合营公司盈利/（亏损）净额 4,473 903 (798) 1,544 226 – – – 6,348",
          "text": "2Q2025非IFRS分占联营合营盈利净额为6348百万元（经调整）",
          "value": 6348,
          "raw_number": "6,348",
          "unit": "人民币百万元",
          "role": "support",
          "status": "observed"
        },
        {
          "chunk_id": "P7AD084B69B1",
          "quote": "分占联营公司及合营公司盈利/（亏损）净额 7,718 926 (91) 1,313 20 – – – 9,886",
          "text": "2Q2024非IFRS分占联营合营盈利净额为9886百万元（经调整），为同比对照基数",
          "value": 9886,
          "raw_number": "9,886",
          "unit": "人民币百万元",
          "role": "support",
          "status": "observed"
        },
        {
          "chunk_id": "P7AD084B61B1",
          "quote": "总收入为人民币1,845 亿元，同比增长15%。",
          "text": "2Q2025总收入1845亿元，同比增15%",
          "value": 1845,
          "raw_number": "1,845",
          "unit": "人民币亿元",
          "role": "support",
          "status": "observed"
        },
        {
          "chunk_id": "P7AD084B61B1",
          "quote": "毛利为人民币1,050 亿元，同比增长22%。",
          "text": "2Q2025毛利1050亿元，同比增22%",
          "value": 1050,
          "raw_number": "1,050",
          "unit": "人民币亿元",
          "role": "support",
          "status": "observed"
        },
        {
          "chunk_id": "P7AD084B65B1",
          "quote": "非国际财务报告准则 本公司权益持有人应占盈利 63,052 57,313",
          "text": "p5表非IFRS归母盈利2Q2025为63052百万元、2Q2024为57313百万元，与p1摘要631亿/同比10%及568亿剔除联营合营后同比20%口径不同（p1为亿元且做了联营合营剔除）",
          "value": 63052,
          "raw_number": "63,052",
          "unit": "人民币百万元",
          "role": "caution",
          "status": "observed"
        },
        {
          "chunk_id": "P7AD084B61B1",
          "quote": "剔除本季及去年同期非国际财务报告准则分占联营公司及合营公司盈利后，2Q2025 的非国际财务报告准则本公司权益持有人归属盈利为人民币568 亿元",
          "text": "568亿元是在631亿元基础上剔除本季及去年同期非IFRS分占联营合营盈利后的结果，两增速基于不同基数与口径，不直接冲突但衡量范围不同",
          "value": 568,
          "raw_number": "568",
          "unit": "人民币亿元",
          "role": "caution",
          "status": "observed"
        },
        {
          "chunk_id": "P7AD084B64B1",
          "quote": "非国际财务报告准则财务计量应被视为根据国际财务报告准则编制的本集团财务业绩的补充而非替代计量",
          "text": "非IFRS计量为IFRS业绩补充而非替代",
          "value": null,
          "raw_number": "",
          "unit": "",
          "role": "definition",
          "status": "definition"
        },
        {
          "chunk_id": "P7AD084B64B1",
          "quote": "非国际财务报告准则调整包括本集团主要联营公司的相关非国际财务报告准则调整",
          "text": "非IFRS调整含主要联营公司相关调整，故剔除联营合营盈利为非IFRS框架内操作",
          "value": null,
          "raw_number": "",
          "unit": "",
          "role": "definition",
          "status": "definition"
        }
      ],
      "limitations": [
        "提供的片段中未找到直接说明两个增速是否冲突的论述；仅能从口径差异推断不必然冲突",
