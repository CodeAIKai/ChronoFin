          "role": "context",
          "evidence_ids": [
            "F01"
          ],
          "numbers": []
        },
        {
          "id": "C2",
          "text": "股票估值相对预期盈利仍高，流动性恶化但整体运转有序",
          "kind": "fact",
          "role": "risk",
          "evidence_ids": [
            "F02"
          ],
          "numbers": []
        },
        {
          "id": "C3",
          "text": "对冲基金杠杆指标接近十年高位且集中于较大基金",
          "kind": "fact",
          "role": "risk",
          "evidence_ids": [
            "F03"
          ],
          "numbers": []
        },
        {
